<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/textViewTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Establecer Recordatorio de Medicina"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:paddingBottom="20dp" />

    <EditText
        android:id="@+id/editTextNombreMedicamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del Medicamento"
        android:padding="10dp"
        android:background="@android:drawable/editbox_background"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/editTextCantidadUmbral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cantidad mínima para recordatorio"
        android:inputType="number"
        android:padding="10dp"
        android:background="@android:drawable/editbox_background"
        android:textSize="18sp"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnEstablecerRecordatorio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Establecer Recordatorio"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:padding="12dp" />

</LinearLayout>
