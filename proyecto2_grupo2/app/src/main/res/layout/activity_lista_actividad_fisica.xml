<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lista de Actividades Físicas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="10dp"/>

    <!-- ListView para mostrar las actividades registradas -->
    <ListView
        android:id="@+id/listaActividades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:paddingVertical="8dp"/>

    <!-- Botón para registrar nueva actividad -->
    <Button
        android:id="@+id/btnRegistrarActividad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Nueva Actividad"
        android:textAllCaps="false"

        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"/>

    <!-- Botón para regresar al menú principal -->
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:textAllCaps="false"

        android:textColor="@android:color/white"
        android:layout_marginTop="8dp"/>
</LinearLayout>
